# Copy to .env.local for local dev. Never commit the real file.
#
# The backend base URL is NOT a Vite env var — it's read from an optional
# window.CONFIG.API_BASE_URL global (see index.html), falling back to the
# deployed Render URL if that's never set. Nothing sets it today; it's a
# hook for overriding the API target at deploy time without a rebuild.

# OSRM routing engine the SafeMaster TS port calls directly from the
# browser. Defaults to the public OSRM demo server if unset — see
# ../../map-app-render-deployment/backend/docs/OSRM-SELFHOST.md to self-host.
VITE_OSRM_BASE_URL=https://router.project-osrm.org/route/v1/driving
